{
  "manifest_version": 3,
  "name": "Blocker for Meta / Facebook",
  "version": "1.0",
  "description": "Blocks all requests to main Meta / Facebook URLs",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "declarativeNetRequest"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "meta_facebook_rules",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  }
}
