{
  "manifest_version": 3,
  "name": "Blocker for Meta / Facebook",
  "version": "1.0",
  "description": "Blocks all requests to main Meta / Facebook URLs",
  "permissions": [
    "declarativeNetRequest"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "meta_facebook_rules",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  }
}
